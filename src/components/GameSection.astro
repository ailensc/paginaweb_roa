---
import PsychedelicScreen from "./PsychedelicScreen.astro";
---
<div class="game-card border-[0.5px] border-[rgba(255,45,138,0.2)] bg-[#0e0318] p-5 md:p-[42px] grid grid-cols-1 lg:grid-cols-2 gap-6 items-center relative overflow-hidden rounded-[2px] [transform-style:preserve-3d] [perspective:800px]" data-tilt>
  <div class="flex flex-col">
    <div class="game-ley font-cinzel text-[9px] tracking-[0.3em] text-[#ff85c0] flex items-center gap-[9px] mb-[22px] uppercase">
      <span class="pulse-dot w-[6px] h-[6px] rounded-full bg-[#ff2d8a] border border-[rgba(255,133,192,0.5)] animate-[breathe_1.8s_infinite]"></span>
      In development — UE5
    </div>
    <img src="/logo_con_fondo.png" alt="Ritual Of Awakening" class="w-[200px] h-auto mb-4 self-center" />
    <p class="text-[14px] text-[#c9a8e8] leading-[1.85] mb-7 font-light">
      Ritual of Awakening is a narrative-driven game where players follow a young woman on a symbolic journey beyond the visible world. Through atmospheric environments, environmental puzzles, and encounters with feminine alien entities, players uncover hidden layers of consciousness and reality. Instead of focusing on combat, the game emphasizes exploration, interpretation, and immersive storytelling, creating a unique experience that blends esoteric symbolism, mystical world-building, and personal transformation.
    </p>
    <div class="game-stats flex gap-5 mb-7">
      <div class="sbox border-[0.5px] border-[rgba(255,45,138,0.15)] p-3 px-4 bg-[rgba(255,45,138,0.04)] rounded-[2px] min-w-[68px]">
        <span class="sval font-cinzel text-[14px] font-semibold text-[#ff2d8a] block mb-1">UE5</span>
        <span class="skey font-cinzel text-[9px] text-[#9b72c0] tracking-[0.15em] uppercase">Engine</span>
      </div>
      <div class="sbox border-[0.5px] border-[rgba(255,45,138,0.15)] p-3 px-4 bg-[rgba(255,45,138,0.04)] rounded-[2px] min-w-[68px]">
        <span class="sval font-cinzel text-[14px] font-semibold text-[#ff2d8a] block mb-1">Solo</span>
        <span class="skey font-cinzel text-[9px] text-[#9b72c0] tracking-[0.15em] uppercase">Team</span>
      </div>
      <div class="sbox border-[0.5px] border-[rgba(255,45,138,0.15)] p-3 px-4 bg-[rgba(255,45,138,0.04)] rounded-[2px] min-w-[68px]">
        <span class="sval font-cinzel text-[14px] font-semibold text-[#ff2d8a] block mb-1">2026</span>
        <span class="skey font-cinzel text-[9px] text-[#9b72c0] tracking-[0.15em] uppercase">Start</span>
      </div>
    </div>
    <div class="prog-lbl flex justify-between mb-2">
      <span class="font-cinzel text-[9px] text-[#9b72c0] tracking-[0.12em] uppercase">Progress</span>
      <span class="font-cinzel text-[9px] text-[#ff2d8a] tracking-[0.12em] uppercase">35%</span>
    </div>
    <div class="prog-track h-[1px] bg-[rgba(255,45,138,0.12)]">
      <div class="prog-fill h-[1px] w-[35%] bg-[#ff2d8a] relative">
        <span class="absolute right-[-5px] top-[-5px] text-[8px] text-[#ff2d8a]">◆</span>
      </div>
    </div>
    <button id="donate-btn" class="w-full mt-5 font-cinzel text-[10px] tracking-[0.18em] uppercase px-4 py-3 rounded-[2px] border-[0.5px] border-[rgba(255,215,0,0.3)] text-[#ffd700] bg-[rgba(255,215,0,0.04)] cursor-pointer transition-all duration-250 hover:bg-[rgba(255,215,0,0.12)] hover:border-[#ffd700] flex items-center justify-center gap-2" onclick="copyAddress()">
      <i class="ti ti-coins text-[14px]"></i> Support the Project — USDT (ERC20)
    </button>
  </div>
  <div class="game-vis bg-[#07010f] border-[0.5px] border-[rgba(255,45,138,0.12)] aspect-[16/9] flex flex-col items-center justify-center gap-[18px] relative overflow-hidden rounded-[2px]">
    <video
      src="/Ritual_Of_Awakening_Trailer_Demo_pag_web.mp4"
      autoplay
      muted
      loop
      playsinline
      class="absolute top-0 left-0 w-full h-full object-cover"
      style="z-index:0"
    ></video>
    <div class="ue-crest font-cinzel text-[9px] tracking-[0.22em] text-[rgba(255,133,192,0.5)] border-[0.5px] border-[rgba(255,45,138,0.2)] px-[14px] py-[5px] uppercase relative z-[1] rounded-[2px]">Unreal Engine 5</div>
    <button id="psychedelic-btn" class="absolute bottom-3 left-1/2 -translate-x-1/2 z-[5] font-cinzel text-[9px] tracking-[0.18em] uppercase px-3 py-[5px] rounded-[2px] border-[0.5px] border-[rgba(255,45,138,0.3)] text-[#ff85c0] bg-[rgba(7,1,15,0.7)] cursor-pointer transition-all duration-250 hover:bg-[rgba(255,45,138,0.12)] hover:border-[#ff2d8a]">
      <i class="ti ti-player-play-filled text-[10px] mr-1"></i> View Project
    </button>
    <span class="vis-rune absolute font-cinzel text-[9px] text-[rgba(255,45,138,0.12)] tracking-[0.15em] top-3 left-[14px]">◈ UE5.4</span>
    <span class="vis-rune absolute font-cinzel text-[9px] text-[rgba(255,45,138,0.12)] tracking-[0.15em] bottom-3 right-[14px]">◈ Alpha</span>
  </div>
</div>

<PsychedelicScreen />

<script>
import { initTiltEffect } from "../scripts/tilt-effect";
initTiltEffect();

window.copyAddress = function() {
  const address = "0x6b3ce65ff755fd7762f6bdb2ca752e9095c8e4ca";
  navigator.clipboard.writeText(address).then(() => {
    const btn = document.getElementById("donate-btn");
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="ti ti-check text-[14px]"></i> Copied!';
    setTimeout(() => { btn.innerHTML = orig; }, 2000);
  });
};
</script>
